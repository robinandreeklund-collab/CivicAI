{
  "name": "SMHI Öppna Data",
  "version": "1.0.0",
  "description": "Sveriges Meteorologiska och Hydrologiska Institut - Komplett katalog över öppna väder-API:er",
  "updated": "2025-12-10",
  "provider": {
    "name": "SMHI",
    "url": "https://www.smhi.se/data/oppna-data",
    "api_documentation": "https://opendata.smhi.se/apidocs/",
    "license": "CC BY 4.0",
    "attribution": "© SMHI",
    "requires_api_key": false
  },
  
  "personality_tags": ["metrolog"],
  
  "apis": [
    {
      "name": "smhi_prognos",
      "source": "SMHI",
      "frequency": "timvis",
      "url": "https://opendata-download-metfcst.smhi.se/api/category/pmp3g/version/2/geotype/point/lon/{lon}/lat/{lat}/data.json",
      "url_template": true,
      "keywords": ["väder", "prognos", "temperatur", "nederbörd", "vind", "imorgon", "veckoprognos", "regn", "snö", "sol", "i morgon", "nästa vecka"],
      "priority": 1,
      "description": "SMHI 9-dagars väderprognos - detaljerade prognoser för specifika platser",
      "method": "GET",
      "parameters": {
        "lon": {"type": "float", "required": true, "description": "Longitud (WGS84)"},
        "lat": {"type": "float", "required": true, "description": "Latitud (WGS84)"}
      },
      "data_format": "JSON/GeoJSON",
      "example_url": "https://opendata-download-metfcst.smhi.se/api/category/pmp3g/version/2/geotype/point/lon/18.07/lat/59.33/data.json"
    },
    {
      "name": "smhi_analys",
      "source": "SMHI",
      "frequency": "timvis",
      "url": "https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/1/geotype/point/lon/{lon}/lat/{lat}/data.json",
      "url_template": true,
      "keywords": ["väder nu", "aktuellt väder", "just nu", "temperatur nu", "nu", "aktuellt", "för tillfället"],
      "priority": 2,
      "description": "SMHI väderanalys - aktuellt väderläge och observationer just nu",
      "method": "GET",
      "parameters": {
        "lon": {"type": "float", "required": true, "description": "Longitud (WGS84)"},
        "lat": {"type": "float", "required": true, "description": "Latitud (WGS84)"}
      },
      "resolution": "1x1 km grid",
      "coverage": "Sverige och närområden",
      "data_format": "JSON",
      "example_url": "https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/1/geotype/point/lon/18.07/lat/59.33/data.json"
    },
    {
      "name": "smhi_varningar",
      "source": "SMHI",
      "frequency": "kontinuerlig",
      "url": "https://opendata-download-warnings.smhi.se/ibww/api/version/1",
      "url_template": false,
      "keywords": ["varning", "vädervarning", "storm", "extremväder", "oväder", "fara", "varningar", "klass"],
      "priority": 0,
      "description": "SMHI vädervarningar - konsekvensbaserade vädervarningar för Sverige (klass 1-3)",
      "method": "GET",
      "parameters": {},
      "coverage": "Sverige",
      "data_format": "JSON",
      "example_url": "https://opendata-download-warnings.smhi.se/ibww/api/version/1",
      "notes": "Konsekvensbaserade vädervarningar. Klass 1 = Meddelande om farligt väder, Klass 2 = Varning för mycket farligt väder, Klass 3 = Meddelande om extremt farligt väder"
    },
    {
      "name": "smhi_radar",
      "source": "SMHI",
      "frequency": "15 minuter",
      "url": "https://opendata-download-radar.smhi.se/api/version/latest/area/sweden/product/comp",
      "url_template": false,
      "keywords": ["radar", "nederbördsradar", "regn nu", "regnradar", "var regnar det"],
      "priority": 4,
      "description": "SMHI nederbördsradar - radarbilder som visar nederbörd över Norden",
      "method": "GET",
      "parameters": {},
      "coverage": "Sverige och Norden",
      "data_format": "PNG/GeoTIFF",
      "example_url": "https://opendata-download-radar.smhi.se/api/version/latest/area/sweden/product/comp"
    },
    {
      "name": "smhi_observationer",
      "source": "SMHI",
      "frequency": "timvis",
      "url": "https://opendata-download-metobs.smhi.se/api/version/latest/parameter/1/station-set/all/period/latest-hour/data.json",
      "url_template": false,
      "keywords": ["observationer", "mätdata", "mätstation", "verkligt väder", "uppmätt"],
      "priority": 3,
      "description": "SMHI observationer - senaste mätdata från alla mätstationer",
      "method": "GET",
      "parameters": {},
      "coverage": "SMHI:s alla mätstationer",
      "data_format": "JSON",
      "example_url": "https://opendata-download-metobs.smhi.se/api/version/latest/parameter/1/station-set/all/period/latest-hour/data.json"
    },
    {
      "name": "smhi_stationer",
      "source": "SMHI",
      "frequency": "statisk",
      "url": "https://opendata-download-metobs.smhi.se/api/version/latest/parameter/1/station-set/all.json",
      "url_template": false,
      "keywords": ["mätstation", "station", "stationer", "var finns stationer"],
      "priority": 5,
      "description": "SMHI mätstationer - information om alla mätstationer i Sverige",
      "method": "GET",
      "parameters": {},
      "coverage": "Sverige",
      "data_format": "JSON",
      "example_url": "https://opendata-download-metobs.smhi.se/api/version/latest/parameter/1/station-set/all.json"
    },
    {
      "name": "smhi_klimat",
      "source": "SMHI",
      "frequency": "historisk",
      "url": "https://opendata-download-metobs.smhi.se/api/version/1.0/parameter/1/station/180960/period/corrected-archive/data.json",
      "url_template": false,
      "keywords": ["klimat", "historik", "klimatdata", "statistik", "historia", "förr"],
      "priority": 6,
      "description": "SMHI klimatdata - historisk väderdata och statistik från mätstationer",
      "method": "GET",
      "parameters": {},
      "coverage": "Sverige, historiska mätserier",
      "data_format": "JSON",
      "example_url": "https://opendata-download-metobs.smhi.se/api/version/1.0/parameter/1/station/180960/period/corrected-archive/data.json"
    }
  ],
  
  "entity_config": {
    "entity_required": true,
    "entity_type": "stad",
    "fallback_entity": "Stockholm",
    "entity_extraction": {
      "method": "city_lookup",
      "source": "config/swedish_cities.json",
      "fallback_coordinates": {
        "lon": 18.07,
        "lat": 59.33
      }
    }
  },
  
  "keywords": ["väder", "vädret", "temperatur", "regn", "snö", "sol", "prognos", "grader", "imorgon", "idag", "nu", "nederbörd", "vind"],
  
  "response_format": {
    "include_source": true,
    "include_attribution": true,
    "format_template": "I {stad} {tid}: {temperatur}°C, {nederbördskategori}. {prognos}\n\n**Källa**: SMHI Öppna Data"
  },
  
  "rate_limits": {
    "requests_per_second": 10,
    "requests_per_hour": 1000,
    "notes": "Inga hårda begränsningar, men rekommenderar caching"
  },
  
  "caching_strategy": {
    "forecast": "30 minuter",
    "observations": "15 minuter",
    "warnings": "5 minuter",
    "static_data": "24 timmar"
  },
  
  "error_handling": {
    "fallback_message": "Kunde inte hämta väderdata från SMHI just nu. Försök igen om en stund.",
    "retry_strategy": "exponential_backoff",
    "max_retries": 3
  },
  
  "examples": {
    "query": "Hur blir vädret i Stockholm imorgon?",
    "response": "I Stockholm imorgon: ca 5°C och regn. Molnigt med tillfälliga regnskurar under dagen. Vindar från sydväst 5-8 m/s.\n\n**Källa**: SMHI Punktprognos"
  }
}
