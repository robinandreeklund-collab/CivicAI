# Frontend Environment Variables

# API Backend URL
VITE_API_URL=http://localhost:3001

# ============================================================================
# Model Backend Configuration (GGUF vs .bin)
# ============================================================================

# Backend selection: 'gguf' or 'bin'
# GGUF: Uses llama-server/llama.cpp with chat completions
# bin: Uses legacy HuggingFace transformers backend
VITE_MODEL_BACKEND=bin

# GGUF Server Base URL (when MODEL_BACKEND=gguf)
VITE_GGUF_SERVER_BASE=http://localhost:8080

# Legacy .bin Server Base URL (when MODEL_BACKEND=bin)
VITE_BIN_SERVER_BASE=http://localhost:5000

# ============================================================================
# Firebase Configuration (for client-side)
# ============================================================================

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Analytics (Optional)
VITE_GA_TRACKING_ID=
