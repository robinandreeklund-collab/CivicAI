# CivicAI Local Environment Configuration
# Copy this file to .env.local and customize for your setup

# ============================================================================
# GGUF Backend Configuration
# ============================================================================

# Model backend selection: 'gguf' or 'bin' (HuggingFace)
# When set to 'gguf', all inference requests route to the GGUF server
# When set to 'bin', uses the legacy HuggingFace transformers backend
MODEL_BACKEND=bin

# GGUF Server Base URL
# Default: http://localhost:8080
# This is where llama-server or llama.cpp server is running
GGUF_SERVER_BASE=http://localhost:8080

# Legacy .bin backend base URL (for HuggingFace transformers)
# Default: http://localhost:5000
BIN_SERVER_BASE=http://localhost:5000

# ============================================================================
# System Prompt Configuration
# ============================================================================

# Platform system prompt override (optional)
# If set, this will be used as the system prompt for GGUF inference
# instead of loading from the database or character cards
# Leave empty to use the default platform prompt from get_active_system_prompt()
PLATFORM_SYSTEM_PROMPT=

# ============================================================================
# ML Service Configuration
# ============================================================================

# ML Service port (default: 5000)
ML_SERVICE_PORT=5000

# GGUF-specific flags
# Path to GGUF model file (if using GGUF backend)
# Example: /path/to/model.gguf
GGUF_MODEL_PATH=

# llama-server port (when using pre-built llama.cpp binaries)
LLAMA_SERVER_PORT=8081

# Number of GPU layers to offload (-1 = all, 0 = CPU only)
N_GPU_LAYERS=-1

# Context size for GGUF models (default: 4096, max: 32768)
CONTEXT_SIZE=4096

# Number of CPU threads (default: 8)
THREADS=8

# Temperature for sampling (default: 0.7)
TEMPERATURE=0.7

# ============================================================================
# API Keys (Optional)
# ============================================================================

# Trafikverket API Key
# Get your key from: https://api.trafikinfo.trafikverket.se/
TRAFIKVERKET_API_KEY=

# Tavily Search API Key
# Get your key from: https://tavily.com
TAVILY_API_KEY=

# ============================================================================
# Debug Configuration
# ============================================================================

# Enable debug logging (0 = off, 1 = on)
ONESEEK_DEBUG=0

# Rate limit per minute (default: 1000 for development)
RATE_LIMIT_PER_MINUTE=1000
